spec: v0.6

name: app-wamr

rootfs: ./rootfs

# Customize your filesystem with a bidirectional link between your host
# and the unikernel by uncomment the `volumes` element below:
#
#volumes:
# - ./rootfs/:/vol

unikraft:
  source: https://github.com/dblnz/unikraft.git
  version: update-ukrust-to-1.95
  kconfig:
    CONFIG_LIBDEVFS_AUTOMOUNT: 'y'
    CONFIG_LIBDEVFS_DEV_STDOUT: 'y'
    CONFIG_LIBDEVFS: 'y'
    CONFIG_LIBUKFS_DEVFS: 'y'
    CONFIG_LIBPOSIX_PROCESS: 'y'
    CONFIG_LIBPOSIX_USER: 'y'
    CONFIG_LIBRAMFS: 'y'
    CONFIG_LIBUKCPIO: 'y'
    CONFIG_LIBUKMMAP: 'y'
    CONFIG_LIBUKSCHEDCOOP: 'y'
    CONFIG_LIBVFSCORE: 'y'
    CONFIG_LIBVFSCORE_AUTOMOUNT_CI: 'y'
    CONFIG_LIBVFSCORE_AUTOMOUNT_CI_INITRD: 'y'
    CONFIG_LIBUKRUST: 'y'
    # Networking: POSIX sockets + virtio-net for the HTTP endpoint.
    CONFIG_LIBPOSIX_SOCKET: 'y'
    CONFIG_LIBPOSIX_POLL: 'y'
    CONFIG_LIBUKNETDEV: 'y'
    CONFIG_LIBUKNETDEV_EINFO_LIBPARAM: 'y'
    CONFIG_LIBUKLIBPARAM: 'y'
    CONFIG_HAVE_PCI: 'y'
    CONFIG_LIBUKBUS_PCI: 'y'
    CONFIG_LIBVIRTIO_BUS: 'y'
    CONFIG_LIBVIRTIO_PCI: 'y'
    CONFIG_LIBVIRTIO_NET: 'y'

targets:
- qemu/x86_64

libraries:
  wamr:
    source: https://github.com/dblnz/lib-wamr.git
    version: dev-new
    kconfig:
      - CONFIG_LIBWAMR_MAIN_FUNCTION=y
  lwip:
    source: https://github.com/dblnz/lib-lwip.git
    version: staging
  musl:
    source: https://github.com/dblnz/lib-musl.git
    version: wamr-wip
  lwip:
    source: https://github.com/unikraft/lib-lwip.git
    version: staging
    kconfig:
      - CONFIG_LWIP_UKNETDEV=y
      - CONFIG_LWIP_AUTOIFACE=y
      - CONFIG_LWIP_IPV4=y
      - CONFIG_LWIP_TCP=y
      - CONFIG_LWIP_UDP=y
      - CONFIG_LWIP_DHCP=y
      - CONFIG_LWIP_SOCKET=y
      - CONFIG_LWIP_THREADS=y
      - CONFIG_LWIP_HEAP=y
      - CONFIG_LWIP_LOOPIF=y
      - CONFIG_LWIP_LOOPBACK=y
      - CONFIG_LWIP_ICMP=y
